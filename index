 $("bar").style.width=`${(current+1)/QUESTIONS.length*100}%`;
 $("qnum").textContent=`Q${String(current+1).padStart(2,"0")}`;
 $("qtext").textContent=q.q;
 $("choices").innerHTML="";
 q.a.forEach((a,i)=>{const b=document.createElement("button");b.className="choice"+(answers[current]===i?" selected":"");b.innerHTML=`<span class="letter">${"ABCD"[i]}</span>${a[0]}`;b.onclick=()=>{answers[current]=i;render()};$("choices").appendChild(b)});
 $("prev").disabled=current===0;$("next").textContent=current===QUESTIONS.length-1?"결과 보기":"다음";$("next").disabled=answers[current]===null;
}
function move(d){if(d<0){current--;render();return}if(answers[current]===null)return;if(current<QUESTIONS.length-1){current++;render()}else showResult()}
function calculate(){
 const scores=Object.fromEntries(Object.keys(POSITIONS).map(k=>[k,0]));
 answers.forEach((idx,qi)=>{const a=QUESTIONS[qi].a[idx];scores[a[1]]+=2;scores[a[2]]+=1});
 return scores;
}
function showResult(){
 const scores=calculate(), sorted=Object.entries(scores).sort((a,b)=>b[1]-a[1]);
 const max=sorted[0][1], winners=sorted.filter(x=>x[1]===max).map(x=>x[0]);
 const primary=winners[0], p=POSITIONS[primary], isTie=winners.length>1;
 window.lastPrimaryPosition = primary;
 const names=winners.map(k=>POSITIONS[k].name).join(" · ");

 const ranked=sorted.map(([k,v])=>`<div class="score-row"><span>${POSITIONS[k].name}</span><div class="track"><div class="fill" style="width:${max?100*v/max:0}%"></div></div><b>${v}</b></div>`).join("");

 const allTags=[...new Set(winners.flatMap(k=>POSITIONS[k].tags))];
 const cardDesc=isTie?"두 투수 유형의 성향이 비슷하게 나타났어요!":p.desc;
 const cardArt=`<div class="art-holder"><img class="share-card-art" src="${p.image}" alt="${p.name} 이미지" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"><div class="art-placeholder" style="display:none"><span>${p.emoji}</span><small>PLAYER ART COMING SOON</small></div></div>`;
  const cardNumber=String(Object.keys(POSITIONS).indexOf(primary)+1).padStart(3,"0");
  const shareCard=`
  <div class="share-card" id="shareCard">
    <div class="share-card-head"><span>BEYOND THE NINTH</span><span>BT9 · ${cardNumber}</span></div>
    <div class="share-card-main">
      <div class="share-card-eyebrow">OFFICIAL PITCHER CARD</div>
      <div class="share-card-name">${isTie?names:p.name}</div>
      <div class="share-card-title">${isTie?"공동 1위!":p.title}</div>
      ${cardArt}
      <div class="share-card-tags">${allTags.join(" · ")}</div>
      <div class="share-card-description">${cardDesc}</div>
    </div>
    <div class="share-card-foot"><span>PITCHER TYPE COLLECTION</span><span>${cardNumber} / 003</span></div>
  </div>`;

 const resultImages=winners.map(k=>{
   const pos=POSITIONS[k];
   if(!pos.image)return "";
   return `<div class="result-visual"><img src="${pos.image}" alt="${pos.name} 결과 이미지" onerror="this.parentElement.style.display='none'"></div>`;
 }).join("");

 $("quiz").classList.add("hidden");
 $("result").classList.remove("hidden");

 $("result").innerHTML=`
 <div class="kicker">YOUR PITCHER TYPE</div>
 <div class="emoji">${winners.map(k=>POSITIONS[k].emoji).join(" ")}</div>
 <h2>${isTie?"공동 1위!":p.name}</h2>
 <h3>${isTie?names:p.title}</h3>

 ${resultImages}

 <p class="desc">${isTie?"두 투수 유형의 성향이 비슷하게 나타났어요. 아래 유형들을 함께 확인해 보세요.":p.desc}</p>


 <div>${allTags.map(t=>`<span class="tag">${t}</span>`).join("")}</div>
 <div class="scorelist"><b>투수 유형별 점수</b>${ranked}</div>
 <h3>나만의 투수 카드</h3>${shareCard}
 <div class="actions"><button class="btn secondary" onclick="saveCard()">이미지 저장</button><button class="btn primary" onclick="shareCardImage()">이미지 공유</button></div>
  <div class="actions"><button class="btn primary" id="gifSaveButton" onclick="saveAnimatedCard()">🎞️ 움직이는 GIF 저장</button></div>
 <p class="fine">채점 방식: 각 답변의 주 유형 +2점, 보조 유형 +1점. 선택지의 문구와 연결된 유형만 점수를 얻습니다. A/B/C/D 알파벳 자체는 특정 투수 유형을 뜻하지 않습니다.</p>
 <div class="actions"><button class="btn secondary" onclick="retry()">다시 하기</button><button class="btn primary" onclick="copyResult()">결과 복사</button></div>`;

 window.lastResult=`투수 3유형 성향 테스트 결과: ${names}${isTie?" (공동 1위)":""}`;
}
 
/* PNG와 GIF가 함께 사용하는 저장 전용 카드 */
async function createExportCard(hideArt = false) {
  const original = $("shareCard");
  const clone = original.cloneNode(true);

  clone.removeAttribute("id");

  Object.assign(clone.style, {
    position: "fixed",
    left: "-10000px",
    top: "0",
    width: "600px",
    height: "auto",
    aspectRatio: "auto",
    margin: "0",
    padding: "14px",
    gap: "8px",
    justifyContent: "flex-start",
    boxSizing: "border-box",
    boxShadow: "none"
  });

  const main = clone.querySelector(".share-card-main");
  Object.assign(main.style, {
    flex: "none",
    minHeight: "0",
    height: "auto",
    padding: "18px 14px",
    gap: "10px",
    justifyContent: "flex-start"
  });

  const art = clone.querySelector(".share-card-art");
  const holder = clone.querySelector(".art-holder");
  if (holder) Object.assign(holder.style,{minHeight:"240px",height:"240px",flexShrink:"0"});
 
  // PNG 저장일 때만 정지 이미지로 교체
  if (art && !hideArt) {
    const primaryKey = window.lastPrimaryPosition;
    const pngPath = POSITIONS[primaryKey]?.pngImage;

    if (pngPath) {
      art.src = pngPath;
      art.onerror = () => { art.onerror = null; art.src = POSITIONS[primaryKey].image; };
    }
  }

  if (art) {
    Object.assign(art.style, {
      display: "block",
      // GIF는 로딩 전에도 합성 영역의 너비가 0이 되지 않도록 고정합니다.
      // PNG는 기존처럼 원본 이미지의 가로세로 비율을 유지합니다.
      width: hideArt ? "440px" : "auto",
      maxWidth: "440px",
      height: "240px",
      maxHeight: "240px",
      margin: "4px auto",
      objectFit: "contain",
      objectPosition: "center",
      flexShrink: "0",
      opacity: hideArt ? "0" : "1"
    });
}
  document.body.appendChild(clone);

  try {
    if (document.fonts) await document.fonts.ready;

    if (art && !hideArt) {
      await new Promise(resolve => {
        if (art.complete) return resolve();
        art.onload = resolve;
        art.onerror = resolve;
      });
    }

    await new Promise(resolve =>
      requestAnimationFrame(() =>
        requestAnimationFrame(resolve)
      )
    );

    const cardBox = clone.getBoundingClientRect();
    const imageBox = art ? art.getBoundingClientRect() : null;
    const scale = 1.5;

    const canvas = await html2canvas(clone, {
      scale,
      backgroundColor: "#17283D",
      useCORS: true,
      logging: false,
      scrollX: 0,
      scrollY: 0
    });

    return {
      canvas,
      scale,
      imageBox: imageBox ? {
        x: (imageBox.left - cardBox.left) * scale,
        y: (imageBox.top - cardBox.top) * scale,
        width: imageBox.width * scale,
        height: imageBox.height * scale
      } : null
    };
  } finally {
    clone.remove();
  }
}
async function makeCardBlob() {
  if (typeof html2canvas !== "function") {
    throw new Error("이미지 변환 라이브러리를 불러오지 못했어요.");
  }

  const { canvas } = await createExportCard(false);

  return await new Promise((resolve, reject) => {
    canvas.toBlob(blob => {
      if (blob) resolve(blob);
      else reject(new Error("PNG 변환에 실패했어요."));
    }, "image/png");
  });
}
 async function saveCard(){
 try{const blob=await makeCardBlob(),url=URL.createObjectURL(blob),a=document.createElement("a");a.href=url;a.download="beyond-the-ninth-position.png";document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),10000)}catch(e){alert(e.message)}
}
async function shareCardImage(){
 try{const blob=await makeCardBlob(),file=new File([blob],"beyond-the-ninth-position.png",{type:"image/png"});
 if(navigator.canShare?.({files:[file]})&&navigator.share){await navigator.share({files:[file],title:"나의 야구 포지션 결과"})}
 else{await saveCard();alert("이미지를 저장했어요! SNS에서 이미지를 첨부해 공유해 주세요.")}
 }catch(e){if(e.name!=="AbortError")alert(e.message)}
}

/* GIF 전용 카드: 화면에 보이는 카드는 변경하지 않고, 저장할 때만 컴팩트한 복제본을 사용합니다. */
async function saveAnimatedCard(){
 const btn=$("gifSaveButton");
 let workerURL=null, clone=null;
 try{
  btn.disabled=true;
  btn.textContent="GIF 준비 중…";
  if(typeof html2canvas!=="function" || typeof GIF!=="function")throw new Error("이미지 변환 라이브러리를 불러오지 못했어요.");
  const card=$("shareCard"), art=card.querySelector("img.share-card-art");
  if(!art || !/\.gif(?:[?#]|$)/i.test(art.getAttribute("src")))throw new Error("이 결과에 GIF 이미지가 없어요.");
  const response=await fetch(new URL(art.getAttribute("src"),location.href));
  if(!response.ok)throw new Error("GIF 파일을 불러올 수 없어요.");
  const gifuctjs=await import("https://esm.sh/gifuct-js@2.1.2");
  const parsed=gifuctjs.parseGIF(await response.arrayBuffer());
  const frames=gifuctjs.decompressFrames(parsed,true);
  if(!frames.length)throw new Error("GIF 프레임이 없어요.");

  // PNG와 동일한 카드 배경으로 GIF 생성
  const exported = await createExportCard(true);

  const base = exported.canvas;
  const scale = exported.scale;
  const imageBox = exported.imageBox;

  if (!imageBox || imageBox.width <= 0 || imageBox.height <= 0) {
    throw new Error("GIF 이미지 영역 크기를 계산하지 못했어요.");
  }

  const x = imageBox.x;
  const y = imageBox.y;
  const boxW = imageBox.width;
  const boxH = imageBox.height;

  // 원본 GIF의 부분 프레임을 온전한 이미지로 복원.
  const fw=parsed.lsd.width,fh=parsed.lsd.height;
  if (!fw || !fh) throw new Error("GIF 원본 이미지 크기를 읽지 못했어요.");
  const stage=document.createElement("canvas");stage.width=fw;stage.height=fh;
  const ctx=stage.getContext("2d",{willReadFrequently:true});
  const patch=document.createElement("canvas"),pc=patch.getContext("2d");
  const selected=[];
  let prev=null,restore=null,pendingDelay=0;
  const stride=Math.max(1,Math.ceil(frames.length/90));
  for(let i=0;i<frames.length;i++){
   if(prev){
    if(prev.disposalType===2)ctx.clearRect(prev.dims.left,prev.dims.top,prev.dims.width,prev.dims.height);
    if(prev.disposalType===3 && restore)ctx.putImageData(restore,0,0);
   }
   const f=frames[i];
   restore=f.disposalType===3?ctx.getImageData(0,0,fw,fh):null;
   patch.width=f.dims.width;patch.height=f.dims.height;
   pc.putImageData(new ImageData(f.patch,f.dims.width,f.dims.height),0,0);
   ctx.drawImage(patch,f.dims.left,f.dims.top);
   pendingDelay+=Math.max(20,f.delay||100);
   if(i%stride===0 || i===frames.length-1){
    const frame=document.createElement("canvas");frame.width=fw;frame.height=fh;
    frame.getContext("2d").drawImage(stage,0,0);
    selected.push({frame,delay:pendingDelay});pendingDelay=0;
   }
   prev=f;
  }
  const workerResponse=await fetch("https://cdnjs.cloudflare.com/ajax/libs/gif.js/0.2.0/gif.worker.js");
  if(!workerResponse.ok)throw new Error("GIF 인코더를 불러오지 못했어요.");
  workerURL=URL.createObjectURL(new Blob([await workerResponse.text()],{type:"text/javascript"}));
  const encoder=new GIF({workers:2,quality:12,workerScript:workerURL,repeat:0,width:base.width,height:base.height});
  const result=await new Promise((resolve,reject)=>{
   encoder.on("finished",resolve);
   encoder.on("abort",()=>reject(new Error("GIF 생성이 중단되었어요.")));
   try{
    selected.forEach(({frame,delay},i)=>{
     btn.textContent=`GIF 생성 중 ${i+1}/${selected.length}`;
     const canvas=document.createElement("canvas");canvas.width=base.width;canvas.height=base.height;
     const c=canvas.getContext("2d");
     c.drawImage(base,0,0);
     const ratio=Math.min(boxW/frame.width,boxH/frame.height);
     const w=frame.width*ratio,h=frame.height*ratio;
     c.drawImage(
  frame,
  Math.round(x+(boxW-w)/2),
  Math.round(y+(boxH-h)/2),
  Math.round(w),
  Math.round(h)
);
     encoder.addFrame(canvas,{copy:true,delay});
    });
    encoder.render();
   }catch(e){reject(e)}
  });
  const url=URL.createObjectURL(result),link=document.createElement("a");
  link.href=url;link.download="beyond-the-ninth-animated.gif";
  document.body.appendChild(link);link.click();link.remove();
  setTimeout(()=>URL.revokeObjectURL(url),30000);
 }catch(e){alert("GIF 저장에 실패했어요: "+(e.message||e));}
 finally{
  if(clone)clone.remove();
  if(workerURL)URL.revokeObjectURL(workerURL);
  btn.disabled=false;
  btn.textContent="🎞️ 움직이는 GIF 저장";
 }
}

function retry(){answers=Array(QUESTIONS.length).fill(null);current=0;$("result").classList.add("hidden");$("quiz").classList.remove("hidden");render()}
function copyResult(){if(navigator.clipboard)navigator.clipboard.writeText(window.lastResult).then(()=>alert("결과를 복사했어요!"));else alert(window.lastResult)}
</script>
